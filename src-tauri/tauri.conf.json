{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tessera",
  "version": "0.1.0",
  "identifier": "com.tessera.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tessera",
        "width": 760,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "drop",
        "create": false,
        "title": "Tessera",
        "url": "drop.html",
        "width": 420,
        "height": 520,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "progress",
        "create": false,
        "title": "Tessera",
        "url": "progress.html",
        "width": 384,
        "height": 134,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "kaan0d",
    "copyright": "MIT License",
    "shortDescription": "Convert files from the right-click menu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    },
    "licenseFile": "../LICENSE"
  }
}
