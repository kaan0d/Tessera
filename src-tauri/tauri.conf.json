{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "new-app",
  "version": "0.1.0",
  "identifier": "com.newapp.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "new-app",
        "width": 760,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "progress",
        "title": "new-app",
        "url": "progress.html",
        "width": 384,
        "height": 134,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}