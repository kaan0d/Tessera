{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tessera",
  "version": "0.1.0",
  "identifier": "com.tessera.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tessera",
        "width": 900,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "drop",
        "create": false,
        "title": "Tessera",
        "url": "drop.html",
        "width": 480,
        "height": 620,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "progress",
        "create": false,
        "title": "Tessera",
        "url": "progress.html",
        "width": 384,
        "height": 134,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "setup",
        "create": false,
        "title": "Tessera Setup",
        "url": "install.html",
        "width": 800,
        "height": 520,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "visible": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "kaan0d",
    "copyright": "MIT License",
    "shortDescription": "Convert files from the right-click menu"
  }
}
